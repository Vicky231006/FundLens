table Fund
	lineageTag: d1fd9f03-8894-428e-aef5-b65a3baad4b5

	measure FlaggedFunds = SUM(Fund[FlagCount])
		formatString: #,##0
		lineageTag: 69c9ba47-52ff-4341-99a2-939aae5d8478

	column Category
		dataType: string
		lineageTag: 0ae58c2c-440e-4ac0-b1f3-9982ddf8fb2a
		summarizeBy: none
		sourceColumn: Category

	column FlagCount
		dataType: int64
		lineageTag: c8385d95-6160-411d-bef4-dc591a78267f
		summarizeBy: sum
		sourceColumn: FlagCount

	partition Fund = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost", "fundlens", [Port=5433]),
					View = Source{[Schema="marts", Item="dash_flag"]}[Data],
					Filtered = Table.SelectRows(View, each [is_latest_month_end] = true and [plan_type] = "DIRECT"),
					Grouped = Table.Group(Filtered, {"category"}, {{"FlagCount", each Table.RowCount(_), Int64.Type}}),
					Renamed = Table.RenameColumns(Grouped, {{"category", "Category"}})
				in
					Renamed

