table FundMonth

	column MeDate
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: MeDate

	column Nav
		dataType: double
		summarizeBy: sum
		sourceColumn: Nav

	column scheme_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: scheme_id

	column plan_type
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: plan_type

	partition FundMonth = m
		mode: import
		source =
				let
					Source = Sql.Database("localhost", "fundlens"),
					View = Source{[Schema="marts", Item="dash_fund_month"]}[Data],
					Filtered = Table.SelectRows(View, each [plan_type] = "DIRECT"),
					Selected = Table.SelectColumns(Filtered, {"scheme_id", "plan_type", "me_date", "nav"}),
					Renamed = Table.RenameColumns(Selected, {{"me_date", "MeDate"}, {"nav", "Nav"}})
				in
					Renamed
