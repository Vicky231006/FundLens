table DataQuality

	measure OpenCriticalIssues = ```
			CALCULATE(
				COUNTROWS(DataQuality),
				DataQuality[severity] = "CRITICAL",
				DataQuality[resolution_status] IN { "OPEN", "ACKNOWLEDGED" }
			)
			```
		formatString: #,##0

	column IssueId
		dataType: int64
		summarizeBy: sum
		sourceColumn: IssueId

	column IssueCategory
		dataType: string
		summarizeBy: none
		sourceColumn: IssueCategory

	column severity
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: severity

	column resolution_status
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: resolution_status

	partition DataQuality = m
		mode: import
		source =
				let
					Source = Sql.Database("localhost:5433", "fundlens"),
					View = Source{[Schema="marts", Item="dash_dq_issue"]}[Data],
					Selected = Table.SelectColumns(View, {"issue_id", "issue_category", "severity", "resolution_status"}),
					Renamed = Table.RenameColumns(Selected, {{"issue_id", "IssueId"}, {"issue_category", "IssueCategory"}})
				in
					Renamed

