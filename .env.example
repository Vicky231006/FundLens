# Copy to .env and adjust. .env is gitignored. Never commit real credentials.
POSTGRES_USER=fundlens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fundlens
POSTGRES_HOST=localhost
# Host port 5433 avoids clashing with any local PostgreSQL on 5432.
POSTGRES_PORT=5433

# SQLAlchemy URL used by the Python code (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://fundlens:change_me_locally@localhost:5433/fundlens

# Where original AMFI downloads are preserved (immutable raw layer on disk).
RAW_DATA_DIR=data/raw
